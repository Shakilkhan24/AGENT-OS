{
  "name": "minimal",
  "version": "1.2.10",
  "main": "dist/main/index.cjs",
  "scripts": {
    "build": "node scripts/build.mjs && vite build",
    "typecheck": "tsc --noEmit",
    "start": "npm run build && electron .",
    "start:built": "electron .",
    "test": "tsx scripts/test.mts",
    "test:list": "tsx scripts/test.mts --list && playwright test --list",
    "test:desktop": "playwright test",
    "check": "npm run typecheck && npm test && npm run build",
    "package": "npm run build && node --import tsx scripts/package.mjs",
    "package:rollback": "node --import tsx scripts/package.mjs --rollback",
    "verify:release": "tsx scripts/verify-release.mts",
    "test:package": "tsx tests/package-smoke.ts",
    "test:runtime": "tsx scripts/runtime-spike.mts",
    "probe:providers": "tsx scripts/provider-probe.mts",
    "bench": "tsx scripts/bench.mts",
    "diagnostics:export": "tsx scripts/diagnostics-export.mts",
    "pilot:run": "tsx scripts/run-pilot.mts",
    "pilot:synthetic": "tsx scripts/run-pilot.mts tests/fixtures/pilot-synthetic-charter.json --fixtures-dir tests/fixtures/pilot --out pilot-out --synthetic",
    "hooks:install": "node scripts/install-hooks.mjs",
    "hooks:uninstall": "node scripts/install-hooks.mjs --uninstall"
  },
  "license": "ISC",
  "description": "A local desktop workspace for persistent project sessions, terminals, and scoped files. Built for Linux and WSL2 with WSLg.",
  "keywords": [
    "electron",
    "tmux",
    "terminal",
    "desktop",
    "wsl",
    "linux",
    "developer-tools"
  ],
  "homepage": "https://github.com/Shakilkhan24/AGENT-OS#readme",
  "bugs": {
    "url": "https://github.com/Shakilkhan24/AGENT-OS/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shakilkhan24/AGENT-OS.git"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^1.43.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "electron": "^44.2.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "type": "module"
}
